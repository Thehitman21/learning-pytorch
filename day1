class vanillarmlp(nn.module):
  def __init__(self):
    super().__init__()
    self.flatten =nn.Flatten()
    self.linear_relu_stack=nn.Sequenctial(nn.Linear(28*28,512),nn.ReLU(),nn.linear(512,512),nn.ReLU(),nn.linear(512,10))
  def forward(self,x):
    x=self.flatten(x)
    logits = self.linear_relu_stack(x)
